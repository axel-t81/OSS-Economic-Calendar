# Copy this file to .env for local development, or set these as real
# environment variables / secrets in production (e.g. `fly secrets set ...`).
# Real environment variables always take precedence over .env values.

# --- Core Django ---
# Generate with: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Local dev has an insecure fallback; production REQUIRES this to be set.
DJANGO_SECRET_KEY=change-me

# Leave unset in development (manage.py forces DEBUG=True via development.py).
DJANGO_DEBUG=False

# Comma-separated. Required in production, e.g. your-app.fly.dev,yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite file path. Relative to the project root; absolute paths supported
# (in production on Fly this will point at the persistent volume, e.g. /data/db.sqlite3).
# DJANGO_DB_PATH=db.sqlite3

# --- Email (used by the future daily digest; console backend in development) ---
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_DEFAULT_FROM_EMAIL=OSS Economic Calendar <no-reply@example.com>
